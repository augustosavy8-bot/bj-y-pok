# Copiá este archivo a .env y ajustá lo que necesites. Todo es opcional.

# Puerto local del agente.
PORT=9977

# Origen(es) de la app permitidos por CORS (coma-separado).
ALLOWED_ORIGIN=https://bj-y-pok-augusavy.vercel.app,https://bj-y-pok.vercel.app

# Método de impresión: usb (default, directo) | printer (RAW por nombre de Windows)
METHOD=usb

# --- Solo METHOD=usb ---
# Si hay varias USB o no la detecta sola, fijá el vendor/product id (hex, con 0x).
# Descubrilos con:  npm start  (imprime "USB detectadas") o node -e "console.log(require('./print').listarUSB())"
# USB_VID=0x0483
# USB_PID=0x5743

# --- Solo METHOD=printer ---
# Nombre EXACTO de la impresora en Windows (Panel de control > Dispositivos e impresoras).
# PRINTER_NAME=XP-80

# Ticket
WIDTH=48          # columnas Font A (80mm ~ 48)
FEED_MM=6         # avance de corte por default (si el ticket no manda "corte")
CODEPAGE_ENC=CP858
CODEPAGE_CMD=19   # comando ESC t (19=PC858 en la mayoria de XPrinter; 2=PC850)
